# Копирай като deploy/.env и попълни. НЕ го качвай в git.
SITE_DOMAIN=spark.example.com
ADMIN_DOMAIN=admin-8f3k2x.example.com      # непредвидим адрес; не го споделяй
# Дълги случайни низове:  openssl rand -hex 48
SESSION_SECRET=
ADMIN_SESSION_SECRET=
# Истинска поща за кодовете за потвърждение (напр. Brevo/Mailjet free или Gmail с парола за приложение)
SMTP_URL=smtps://потребител:парола@smtp.example.com:465
MAIL_FROM=Spark <no-reply@example.com>
# Само твоите IP адреси (разделени с интервал). По подразбиране – всички.
ADMIN_ALLOW_IPS=0.0.0.0/0 ::/0
# По избор: TURN за видео обаждания зад строги мрежи (JSON масив)
ICE_SERVERS=
